# DATABASE
MONGO_URI=mongodb://localhost:27017/calcolatore-forfettario
# O per MongoDB Atlas (SRV - richiede DNS senza hijacking):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/calcolatore-forfettario?retryWrites=true&w=majority

# CONNECTION STRING STANDARD (senza +srv) - usa se il router blocca le query DNS SRV.
# Ottienila da Atlas → Connect → Drivers → Node.js → versione 2.2.12 or later
# MONGO_URI_STANDARD=mongodb://username:password@shard-00-00.xxx.mongodb.net:27017,shard-00-01.xxx.mongodb.net:27017,shard-00-02.xxx.mongodb.net:27017/calcolatore-forfettario?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority

# CRITTOGRAFIA
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# INIZIALIZZAZIONE
DROP_EXISTING=false

# AMBIENTE
NODE_ENV=development
PORT=5000

# FRONTEND URL
FRONTEND_URL=http://localhost:5173

# EMAIL (opzionale)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AWS S3 (per upload files)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=calcolatore-forfettario-docs

# API CUBE (per fatture elettroniche)
APICUBE_CLIENT_ID=your_client_id
APICUBE_CLIENT_SECRET=your_client_secret

# ADE (Agenzia delle Entrate) - Portale Fatture e Corrispettivi
# Certificato digitale del consulente in formato PFX/P12 per autenticazione mTLS
ADE_BASE_URL=https://ivaservizi.agenziaentrate.gov.it/ser
ADE_CERT_PATH=./certs/consulente.pfx
ADE_CERT_PASSWORD=your_pfx_password

# STRIPE (per pagamenti SaaS)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
